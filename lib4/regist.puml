@startuml
title Регистрация пользователя

start

:Открыть страницу регистрации;
:Ввести имя, email и пароль;
:Нажать кнопку "Зарегистрироваться";

if (Все поля заполнены?) then (Да)
  if (Данные корректны?) then (Да)
    :Проверить email в базе данных;
    if (Пользователь существует?) then (Да)
      :Показать ошибку регистрации;
    else (Нет)
      :Создать учетную запись;
      :Сохранить пользователя в БД;
      :Показать сообщение об успешной регистрации;
    endif
  else (Нет)
    :Показать ошибку валидации;
  endif
else (Нет)
  :Показать сообщение о незаполненных полях;
endif

stop
@enduml
