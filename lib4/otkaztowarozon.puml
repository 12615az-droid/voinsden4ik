
@startuml
title Отказ от товара

start

:Открыть личный кабинет;
:Перейти к списку заказов;
:Выбрать заказ;
:Выбрать товар;
:Нажать "Отказаться от товара";

:Проверить статус заказа;

if (Отказ возможен?) then (Да)
  :Указать причину отказа;
  :Подтвердить отказ;

  if (Отказ подтвержден?) then (Да)
    :Сохранить отказ в БД;
    :Обновить статус товара;

    if (Товар оплачен?) then (Да)
      :Создать заявку на возврат средств;
    endif

    :Уведомить пользователя;
  else (Нет)
    :Вернуться к заказу;
  endif
else (Нет)
  :Показать сообщение о невозможности отказа;
endif

stop
@enduml
